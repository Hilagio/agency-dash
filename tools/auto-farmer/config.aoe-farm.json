{
  "_readme": [
    "Stationary AOE farming: F1 + 5 on cooldown, 1/2/3 for HP pots, 6 for MP.",
    "Before running: (1) set window_title_contains, (2) calibrate the two bars",
    "with 'python calibrate.py pick' — the x/y values below are placeholders,",
    "(3) set the real cooldowns for 'aoe f1' and 'aoe 5'.",
    "Copy this file to config.json, which is gitignored."
  ],

  "backend": "auto",
  "window_title_contains": "",
  "tick_seconds": 0.05,
  "global_cooldown_seconds": 0.25,
  "max_runtime_minutes": 0,

