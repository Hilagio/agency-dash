generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Organizations (SaaS multi-tenancy) ──────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   OrganizationMember[]
  invites   OrganizationInvite[]
  accounts  Account[]
  sops      AgencySop[]
  oauthCred OAuthCredential?
  notion    NotionConnection?
  slack     SlackConnection?
  owners    Owner[]
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships OrganizationMember[]
  watches     AccountWatch[]
}

// A per-user "my accounts" watchlist: the accounts a manager is working on, so
// the portfolio can open focused on them. Distinct from Owner (agency AM), which
// isn't tied to a login.
model AccountWatch {
  id        String   @id @default(cuid())
  userId    String
  accountId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([userId, accountId])
  @@index([userId])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  role           String       @default("SPECIALIST") // OWNER | ADMIN | SPECIALIST
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
}

model OrganizationInvite {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  email          String
  role           String       @default("SPECIALIST")
  token          String       @unique @default(cuid())
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  usedAt         DateTime?
}

// ─── Accounts ────────────────────────────────────────────────────────────────

model Account {
  id            String  @id @default(cuid())
  name          String
  googleAdsId   String  @unique
  currency      String  @default("USD")
  monthlyBudget Float?
  industry      String?
  clientContext String? // free-text: what they sell, landing page, target CPA, USPs etc.

  // ─── Per-account scoring targets ───────────────────────────────────────────
  // Set these to get accurate FUNNEL + ECONOMICS scores.
  // They override whatever Google Ads campaign targets return.
  targetRoas         Float? // e.g. 4.0 → 4x ROAS target (ecommerce)
  targetCpa          Float? // e.g. 25.00 → €25 CPA target (lead-gen; also used as target CPL)
  grossMarginPercent Float? // e.g. 0.38 → 38% gross margin (for break-even ROAS check)
  leadToSaleRate     Float? // e.g. 0.15 → 15% of leads close (from CRM)
  landingPageUrl     String? // primary landing page — scraped for CRO briefs

  // ─── Market & business context (affects benchmarks) ──────────────────────
  // country auto-detected from customer.time_zone; this field overrides that detection
  country          String? // ISO 3166-1 alpha-2 (PL, DE, GB, US…) — adjusts CVR benchmarks
  businessModel    String? // dropship | subscription | dtc | service | lead_gen | marketplace
  monthlyChurnRate Float? // 0–1, subscription only (e.g. 0.05 = 5%/mo) — used for LTV calc
  // AOV is computed live from conversions_value / conversions — no manual field needed

  slackChannelId   String? // Slack channel ID (e.g. C0123456789)
  slackChannelName String? // Human-readable name (e.g. #cherie-boutique)

  // ─── Account Ownership System ────────────────────────────────────────────
  // Sync key + read-only mirror of the Notion "Stores" database.
  notionPageId String? @unique // Notion Stores page id — sync key
  clientName   String? // resolved from the Notion "Client" relation
  active       Boolean @default(true) // false when the store leaves "Active" in Notion
  archived     Boolean @default(false) // manual hide — wins over Notion sync; never re-activated by sync

  ownerId String? // -> Owner.id — seeded by hand (the AM who owns this account)
  owner   Owner?  @relation(fields: [ownerId], references: [id])

  // Ownership KPI + tolerances (drive the red/yellow/green rules engine).
  // Distinct from targetRoas/targetCpa above, which feed the constraint scorer.
  primaryKpi   String? // 'ROAS' | 'CPA'
  targetValue  Float? // target for primaryKpi (e.g. 2.8 ROAS, or €25 CPA)
  tolYellowPct Int     @default(10) // deficit % -> yellow
  tolRedPct    Int     @default(25) // deficit % -> red

  pacingGreenMin  Int @default(90)
  pacingGreenMax  Int @default(110)
  pacingYellowMin Int @default(80)
  pacingYellowMax Int @default(120)

  reviewFrequencyDays   Int   @default(7)
  minSpendForEval       Float @default(0)
  minConversionsForEval Float @default(0)

  ownershipEnabled Boolean @default(false) // pilot flag: on for 5-10 accounts first

  // ─── Diagnostic spine (BUILD-SPEC §4/§6) ───────────────────────────────────
  roasFloor         Float?               // hard guardrail: below this, budget may not rise
  conversionLagDays Int     @default(4)  // measured click→conversion lag; drives provisional windows (§4.2)
  timezone          String?              // account timezone — Google Ads reports in it (§4.4)
  dataVerified      Boolean @default(false) // §4.9: DATA_UNVERIFIED until reconciled → produces no signals

  // ─── Team-confirmed tracking status (resolve-and-re-reason) ───────────────
  // When the Expert read hypothesizes a conversion-tracking break, the team can
  // verify it end-to-end and record the answer here, so the read reasons from
  // certainty instead of hedging every ROAS figure forever.
  trackingStatus String?   // "verified" (working) | "broken" | null (unknown)
  trackingNote   String?   // optional detail ("test purchase fired on 2026-07-14")
  trackingSetAt  DateTime?
  trackingSetBy  String?   // email of the person who confirmed

  // ─── Portfolio morning briefing (§agent) ─────────────────────────────────
  // A one-line agent opener ("conversions on X fell to near zero — likely
  // payments/tracking"), generated by the nightly refresh so the dashboard
  // greets the team with what it noticed. Cleared (null) when an account is green.
  briefing       String?
  briefingStatus String?   // the status at generation time (red/yellow/green)
  briefingAt     DateTime?

  // ─── Merchant Center (for price competitiveness) ─────────────────────────
  // Auto-discovered via product_link on first load; set manually as fallback
  // if auto-discovery fails (e.g. the MC is owned by a different Google account).
  merchantCenterId String?

  // ─── Peer group (internal agency use only — never shown to clients) ────────
  // Free-text label grouping competitor accounts managed by the same agency.
  // e.g. "polish-fashion" groups Moda Poznan + Perlowa Moda for gap analysis.
  // Falls back to auto-detection by industry + country if not set.
  peerGroupId String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  snapshots    ConstraintSnapshot[]
  actions      ActionRecommendation[]
  chatSessions ChatSession[]
  notes        AccountNote[]
  sopProgress  AccountSopProgress[]

  // Ownership system
  statusHistory    AccountStatus[]
  slackState       AccountSlackState?
  reviews          Review[]
  ownershipActions OwnershipAction[]
  exceptions       Exception[]
  escalations      Escalation[]

  // Diagnostic spine
  metricsDaily     MetricDaily[]
  productDaily     MetricProductDaily[]
  searchTermsDaily SearchTermDaily[]
  changeEvents     ChangeEvent[]

  // Commerce (Shopify order feed — §4.3 reconciliation, POAS)
  shopify          ShopifyConnection?
  ordersDaily      OrderDaily[]
  shopifyUploads   ShopifyUpload[]

  // Product-level (ad performance vs real sales, + catalog)
  productAdsDaily   ProductAdsDaily[]
  productSalesDaily ProductSalesDaily[]
  products          Product[]

  // Per-user "my accounts" watchlist entries pointing at this account.
  watchers AccountWatch[]

  // Client Context Pack (the enrichment the data can't fetch — drives the plan).
  clientContextPack ClientContext?

  // The ongoing agent conversation for this account (§agent memory).
  agentMessages AgentMessage[]

  // The library of client-ready documents the agent generated for this account.
  generatedDocs GeneratedDoc[]
}

// A saved, client-ready brand document (§agent → files out). The rendered HTML
// is stored so the team has a versioned library of deliverables per account —
// reopen, re-download, or send any past generation.
model GeneratedDoc {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  title     String
  docType   String  // "Findings" | "Account Review" | ...
  format    String  // "doc" | "deck"
  language  String  // "en" | "nl"
  filename  String
  html      String  // the full rendered, on-brand HTML
  createdBy String? // email of the teammate who generated it
  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
}

// The persistent agent conversation for one account (§agent). One ongoing
// thread the whole team shares: the agent's reads/openers plus the context the
// team feeds back ("payments were down 3-10 July"). This is the memory — every
// future read reasons with what's already been said, so the agent stops
// re-guessing what it's already been told.
model AgentMessage {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  role      String   // "assistant" (the agent) | "user" (the team)
  content   String   // markdown for assistant, plain text for user
  kind      String   @default("chat") // "opener" (a fresh read) | "chat" (a reply)
  author    String?  // email of the teammate, for user messages
  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
}

// The Client Context Pack (SOP v2.0): the six enrichment inputs that don't live
// in any Google/Shopify export, captured once per client. Mirrors the Typeform.
// The make-or-break factor is the field that carries the plan's value.
model ClientContext {
  id        String  @id @default(cuid())
  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  amName            String? // account manager
  goal              String? // what does the client want to achieve?
  mainKpi           String? // their main KPI for us to hit
  targetRoasNote    String? // target ROAS — and have they hit it before?
  adsStartedNote    String? // when did their Google Ads account start spending?
  strategyPreference String? // scale aggressively | cautious | balanced (free text)
  usps              String? // what makes this client different?
  audienceNuances   String? // audiences the algorithm must learn separately
  makeOrBreak       String? // ⭐ the make-or-break particularity (the key field)
  anythingElse      String? // constraints / stock inputs / anything else

  // Optional P&L enrichment for exact margin steering (POAS).
  netMarginPct  Float?  // e.g. 0.28 → 28% net margin
  breakEvenRoas Float?  // e.g. 2.0

  defaultLanguage String   @default("en") // "en" | "nl"
  updatedBy       String?  // email of last editor
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

// ─── Diagnostic spine — one timeline per client (BUILD-SPEC §6) ────────────────
// Every source is a daily series or timestamped event keyed by account. `date`
// is a YYYY-MM-DD string in the account's timezone (matches Google's
// segments.date; avoids tz drift). Amounts are already converted from micros to
// the account currency at ingest time.

model MetricDaily {
  id              String  @id @default(cuid())
  accountId       String
  account         Account @relation(fields: [accountId], references: [id])
  date            String  // YYYY-MM-DD (account tz)
  campaignId      String
  campaignName    String
  spend           Float
  impressions     Int
  clicks          Int
  conversions     Float
  conversionValue Float

  @@unique([accountId, date, campaignId])
  @@index([accountId, date])
}

model MetricProductDaily {
  id              String  @id @default(cuid())
  accountId       String
  account         Account @relation(fields: [accountId], references: [id])
  date            String
  landingPageUrl  String  // page-level is where concentration shows up (§4.7)
  productId       String?
  productTitle    String?
  clicks          Int
  spend           Float
  conversions     Float
  conversionValue Float

  @@unique([accountId, date, landingPageUrl])
  @@index([accountId, date])
}

model SearchTermDaily {
  id              String  @id @default(cuid())
  accountId       String
  account         Account @relation(fields: [accountId], references: [id])
  date            String
  campaignId      String
  searchTerm      String
  matchType       String
  clicks          Int
  cost            Float
  conversions     Float
  conversionValue Float

  @@unique([accountId, date, campaignId, searchTerm])
  @@index([accountId, date])
}

// Google Ads change_event log — "cheapest, highest-value data source" (§2/§12).
model ChangeEvent {
  id           String   @id @default(cuid())
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id])
  changedAt    DateTime
  userEmail    String?
  campaignName String?
  resourceType String
  changeType   String   // BUDGET | BIDDING | KEYWORD | NEGATIVE | STATUS | ASSET | OTHER
  oldValue     String?
  newValue     String?
  raw          String
  dedupeKey    String   @unique // stable hash so re-runs upsert instead of duplicating

  @@index([accountId, changedAt])
}

// ─── Commerce (Shopify) — the order feed (BUILD-SPEC §4.3/§8, Phase 8) ─────────
// Shopify is the source of truth for actual orders. OrderDaily is reconciled
// against Google Ads conversions; when they don't match, the system stops
// trusting the ads number (§4.3). Revenue drives POAS alongside account margin.

model ShopifyConnection {
  accountId   String    @id
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  shopDomain  String    @unique // e.g. "acme.myshopify.com"
  accessToken String    // OAuth (or custom-app) Admin API token — secret
  scope       String    @default("")
  installedAt DateTime  @default(now())
  lastSyncAt  DateTime?
  updatedAt   DateTime  @updatedAt
}

// Freshness mark for MANUALLY uploaded Shopify data (CSV exports), per account
// per kind. The data itself lives in OrderDaily / ProductSalesDaily; this records
// WHEN it was uploaded and the date range it covers, so the agent keeps using it
// until it's stale — and always states how old it is instead of implying it's live.
model ShopifyUpload {
  id         String   @id @default(cuid())
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind       String   // "daily_sales" | "product_sales" | "inventory"
  source     String   @default("csv")
  uploadedAt DateTime @default(now())
  uploadedBy String?  // email of the team member who uploaded
  rows       Int      @default(0)
  rangeStart String?  // earliest date present in the file (YYYY-MM-DD)
  rangeEnd   String?  // latest date present in the file (YYYY-MM-DD)

  @@unique([accountId, kind])
  @@index([accountId])
}
model OrderDaily {
  id        String @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id])
  date      String  // YYYY-MM-DD (account tz)
  orders    Int
  revenue   Float
  currency  String  @default("EUR")

  @@unique([accountId, date])
  @@index([accountId, date])
}

// ─── Product-level (BUILD-SPEC §4 concentration, §8 buyability) ────────────────
// Two per-day series joined per product: what the ads did (Google Ads shopping)
// vs what actually sold (Shopify line items). Plus the current Shopify catalog.

model ProductAdsDaily {
  id              String  @id @default(cuid())
  accountId       String
  account         Account @relation(fields: [accountId], references: [id])
  date            String  // YYYY-MM-DD
  itemId          String  // Google Ads product_item_id (Merchant offer id)
  title           String  @default("")
  spend           Float
  clicks          Int
  impressions     Int
  conversions     Float
  conversionValue Float

  @@unique([accountId, date, itemId])
  @@index([accountId, date])
}

model ProductSalesDaily {
  id           String  @id @default(cuid())
  accountId    String
  account      Account @relation(fields: [accountId], references: [id])
  date         String  // YYYY-MM-DD
  productId    String  // Shopify product id
  variantId    String  @default("") // Shopify variant id ("" = product-level / unknown)
  title        String  @default("")
  variantTitle String  @default("")
  units        Int
  revenue      Float
  currency     String  @default("EUR")

  @@unique([accountId, date, productId, variantId])
  @@index([accountId, date])
}

model Product {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  externalId  String   // Shopify product gid
  title       String   @default("")
  productType String?
  status      String?  // ACTIVE | ARCHIVED | DRAFT
  price       Float?
  sku         String?
  updatedAt   DateTime @updatedAt

  @@unique([accountId, externalId])
}

// ─── Account Ownership System ─────────────────────────────────────────────────
// The engine and Slack ownership flow are the system of record; Notion is a
// read-only source that only answers "which stores exist".

model Owner {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  slackUserId    String? // Slack user id (e.g. U0123456789) — for @mention / DM
  isTeamLead     Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  accounts         Account[]
  ownershipActions OwnershipAction[]

  @@unique([organizationId, name])
}

model AccountStatus {
  id         String   @id @default(cuid())
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id])
  computedAt DateTime @default(now())
  status     String // 'green' | 'yellow' | 'red'
  reasons    String   @default("[]") // JSON: [{ rule, severity, message }]
  metrics    String   @default("{}") // JSON: the metrics behind the decision

  @@index([accountId, computedAt])
}

model AccountSlackState {
  accountId         String    @id
  account           Account   @relation(fields: [accountId], references: [id])
  cardMessageTs     String? // ts of the pinned status card (for chat.update)
  lastAlertedStatus String? // last status we alerted on ('green'|'yellow'|'red')
  lastAlertAt       DateTime?
  updatedAt         DateTime  @updatedAt
}

model Review {
  id         String   @id @default(cuid())
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id])
  reviewedBy String // Owner name or Slack user id
  reviewedAt DateTime @default(now())
  note       String

  @@index([accountId, reviewedAt])
}

model OwnershipAction {
  id           String    @id @default(cuid())
  accountId    String
  account      Account   @relation(fields: [accountId], references: [id])
  openedAt     DateTime  @default(now())
  statusAtOpen String // 'yellow' | 'red'
  ownerId      String?
  owner        Owner?    @relation(fields: [ownerId], references: [id])
  deadlineAt   DateTime?

  investigated   String? // "What did you check?"
  conclusion     String? // "What is your conclusion?"
  actionTaken    String? // "What action did you take?"
  noChangeReason String? // "…or why is no change the right call?"
  reassessAt     DateTime? // "When will you re-assess?"

  closedAt DateTime?
  closedBy String?

  escalations Escalation[]

  @@index([accountId, openedAt])
}

model Exception {
  id            String   @id @default(cuid())
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id])
  reason        String
  suppressRules String   @default("[]") // JSON: rule ids this exception suppresses
  startsAt      DateTime @default(now())
  endsAt        DateTime // MANDATORY end date — no permanent green-washing
  createdBy     String

  @@index([accountId, endsAt])
}

model Escalation {
  id           String           @id @default(cuid())
  accountId    String
  account      Account          @relation(fields: [accountId], references: [id])
  actionId     String?
  action       OwnershipAction? @relation(fields: [actionId], references: [id])
  type         String // e.g. 'red_no_followup' | 'deadline_passed'
  escalatedAt  DateTime         @default(now())
  notifiedUser String? // Slack user id of the team lead notified

  @@index([accountId, escalatedAt])
}

// ─── Constraint Snapshot ─────────────────────────────────────────────────────

model ConstraintSnapshot {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  createdAt DateTime @default(now())

  rawSignals String

  scoreMeasurement Float
  scoreTraffic     Float
  scoreConversion  Float
  scoreFunnel      Float
  scoreEconomics   Float

  governingConstraint String
  constraintReason    String

  actions ActionRecommendation[]
}

// ─── Action Recommendations ──────────────────────────────────────────────────

model ActionRecommendation {
  id         String              @id @default(cuid())
  accountId  String
  account    Account             @relation(fields: [accountId], references: [id])
  snapshotId String?
  snapshot   ConstraintSnapshot? @relation(fields: [snapshotId], references: [id])
  createdAt  DateTime            @default(now())

  bucket         String
  title          String
  description    String
  impact         String
  effort         String
  safeToAutomate Boolean @default(false)
  actionType     String
  actionPayload  String?

  status       String    @default("PENDING")
  executedAt   DateTime?
  executionLog String?

  snoozedUntil DateTime?
  assignedTo   String?
  doneNote     String?

  isEscalation Boolean @default(false)
}

// ─── OAuth Credentials (per organization) ────────────────────────────────────

model OAuthCredential {
  id              String       @id @default(cuid())
  organizationId  String       @unique
  organization    Organization @relation(fields: [organizationId], references: [id])
  refreshToken    String
  customerIds     String       @default("[]")
  loginCustomerId String?
  updatedAt       DateTime     @updatedAt
}

// ─── Chat ─────────────────────────────────────────────────────────────────────

model ChatSession {
  id        String        @id @default(cuid())
  accountId String
  account   Account       @relation(fields: [accountId], references: [id])
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id])
  role      String
  content   String
  createdAt DateTime    @default(now())
}

// ─── Agency SOPs / Knowledge Base ────────────────────────────────────────────

model AgencySop {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  title          String
  content        String
  tags           String       @default("[]")
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  progress AccountSopProgress[]
}

// ─── Notion Integration ───────────────────────────────────────────────────────

model NotionConnection {
  id              String       @id @default(cuid())
  organizationId  String       @unique
  organization    Organization @relation(fields: [organizationId], references: [id])
  accessToken     String // Notion internal integration token
  workspaceName   String?
  selectedPageIds String       @default("[]") // JSON: page IDs to pull into AI context
  lastSyncedAt    DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  pageCache NotionPageCache[]
}

model NotionPageCache {
  id           String           @id @default(cuid())
  connectionId String
  connection   NotionConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  pageId       String
  title        String
  content      String // plain text extracted from Notion blocks
  fetchedAt    DateTime         @default(now())

  @@unique([connectionId, pageId])
}

// ─── AI Feedback & Learning ───────────────────────────────────────────────────

model ChatFeedback {
  id           String   @id @default(cuid())
  messageId    String // ChatMessage.id this feedback is about
  orgId        String
  rating       String // "up" | "down"
  correction   String? // what the correct answer should have been
  questionText String? // the user question that preceded this answer
  createdAt    DateTime @default(now())
}

model LearnedPattern {
  id           String   @id @default(cuid())
  orgId        String? // null = global (all orgs); set = org-specific
  questionType String // short label, e.g. "ROAS drop diagnosis"
  pattern      String // the correct approach / answer pattern
  seenCount    Int      @default(1)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Slack Integration ────────────────────────────────────────────────────────

model SlackConnection {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id])
  botToken       String // xoxb- bot token
  teamId         String?
  teamName       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ─── Account Notes / Change Log ───────────────────────────────────────────────

model AccountNote {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  content   String
  author    String   @default("")
  createdAt DateTime @default(now())
}

// ─── SOP Progress Tracking ───────────────────────────────────────────────────

model AccountSopProgress {
  id             String    @id @default(cuid())
  accountId      String
  account        Account   @relation(fields: [accountId], references: [id])
  sopId          String
  sop            AgencySop @relation(fields: [sopId], references: [id])
  completedSteps String    @default("[]")
  startedAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([accountId, sopId])
}
